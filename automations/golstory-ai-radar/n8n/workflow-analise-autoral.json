          "excerpt": "={{$('Artigo gerado com sucesso?').item.json.resumo_meta}}",
          "status": "publish",
          "authorId": "={{$env.WORDPRESS_AUTHOR_ID_WEMERSON}}",
          "categories": "={{ [ Number($env.WORDPRESS_CATEGORY_ID_ANALISE) ] }}",
          "featuredMedia": "={{$json.id}}"
        }
      },
