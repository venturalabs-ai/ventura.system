# Copie este arquivo para ".env" no mesmo diretorio e preencha os valores.
# NUNCA faca commit do arquivo ".env" real (ele fica no .gitignore).

# --- Traefik (infra existente no VPS Hostinger) ---
# Rode "docker network ls" no VPS e confirme o nome da rede externa
# criada pelo stack Traefik da Hostinger antes de preencher.
TRAEFIK_NETWORK=traefik_default
# Nome do certresolver configurado no Traefik (confira no docker-compose
# ou nos labels do proprio container do Traefik).
TRAEFIK_CERTRESOLVER=myresolver

# --- n8n ---
# Subdominio dedicado ao n8n, com DNS apontando (registro A) para o IP do VPS.
N8N_SUBDOMAIN=n8n.golstory.com.br
# Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Postgres (tabela de controle/dedupe do GOLstory) ---
POSTGRES_USER=golstory
POSTGRES_PASSWORD=

# --- WordPress (GOLstory.com.br) ---
# Crie em wp-admin -> Usuarios -> Perfil -> Senhas de Aplicativo (Application Passwords)
WORDPRESS_URL=https://golstory.com.br
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
WORDPRESS_AUTHOR_ID_REDACAO=
WORDPRESS_AUTHOR_ID_WEMERSON=
WORDPRESS_CATEGORY_ID_RADAR=
WORDPRESS_CATEGORY_ID_ANALISE=

# --- IA (texto) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- IA (geracao de imagem de capa) ---
IMAGE_API_PROVIDER=openai
OPENAI_API_KEY=
